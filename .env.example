# Copy to .env and adjust. Never commit real secrets.

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/police_municipale
PORT=3001

# --- Runtime ---
NODE_ENV=development
TRUST_PROXY=false

# --- Sessions & passwords ---
SESSION_TTL_HOURS=8
BCRYPT_ROUNDS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# --- HTTPS (see `npm run cert:dev` for local certs) ---
HTTPS_ENABLED=false
# HTTPS_KEY_PATH=.certs/dev-key.pem
# HTTPS_CERT_PATH=.certs/dev-cert.pem
# HTTP_REDIRECT_PORT=3002

# --- CORS / browser origins (comma separated) ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001

# --- Rate limiting ---
RATE_LIMIT_GLOBAL=600
RATE_LIMIT_LOGIN=8

# --- Sensitive administration (disable in production) ---
ALLOW_DB_RECONNECT=true
ALLOW_DEMO_RESET=true
